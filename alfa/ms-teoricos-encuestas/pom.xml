<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>ar.edu.utn.tup.g04</groupId>
  <artifactId>ms-teoricos-encuestas</artifactId>
  <version>0.1.0-ALFA</version>
  <name>ms-teoricos-encuestas</name>
  <description>Tema 04 - Teoricos y Encuestas. Alfa: solo modulo teoricos.</description>

  <properties>
    <java.version>21</java.version>
    <!-- Sin esto javac usa la codificacion nativa de la maquina (Cp1252 en
         Windows) y todo acento o simbolo de un literal se compila mal. Se
         detecto con el punto medio del resumen de la ficha, que llegaba al
         Tema 03 como mojibake. Vale para todo el equipo, no solo para una
         maquina. -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    <!-- La del BOM de Spring Boot 3.3.5 es 1.19.8, que no lee el contexto de
         Docker: en una maquina con Docker Desktop y el contexto desktop-linux
         busca //./pipe/docker_engine, que no existe, y todos los IT fallan con
         "Could not find a valid Docker environment". Desde 1.20 lo resuelve solo. -->
    <testcontainers.version>1.20.4</testcontainers.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        Dos cosas que la maquina rompia y el codigo no, las dos arregladas aca
        para que no dependan de lo que cada uno tenga configurado en su HOME.

        `user.timezone`: la JVM de Windows puede resolver la zona local a un id
        que no existe en IANA (`America/Buenos_Aires` en vez de
        `America/Argentina/Buenos_Aires`). El driver de Postgres se la manda al
        servidor al conectar y el servidor la rechaza con
        `FATAL: invalid value for parameter "TimeZone"`. Se fija UTC y no la
        zona de Argentina porque UTC es lo que corre el contenedor en
        produccion: los tests quedan mas cerca de lo real, no mas lejos. El
        dominio guarda `Instant`, asi que nada depende de la zona local.

        `api.version`: Testcontainers 1.20.4 negocia con el demonio una version
        de API vieja y Docker Engine 29 —que subio el minimo a 1.44— le
        contesta 400 a /info. El sintoma engania: reporta "Could not find a
        valid Docker environment", como si Docker no estuviera corriendo,
        mientras el CLI funciona perfecto al lado. Cuando se suba
        Testcontainers a una version que negocie sola, este flag sobra.
        (No sirve ponerlo en un `testcontainers.properties` del classpath:
        Testcontainers lee esa clave solo de propiedades de sistema, de
        variables de entorno y del `~/.testcontainers.properties` de cada uno.)
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Duser.timezone=UTC</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>-Duser.timezone=UTC -Dapi.version=1.44</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
