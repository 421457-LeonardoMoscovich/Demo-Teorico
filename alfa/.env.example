# Copiar a .env antes de levantar: cp .env.example .env
# El .env real NO va al repositorio.

POSTGRES_PASSWORD=postgres

# Sesion de usuario. Lo emite nuestro adaptador falso de identidad y se va
# entero el dia que exista el Tema 01.
SECRETO_SESION=alfa-g04-secreto-de-sesion-no-usar-en-produccion

# Vale de lectura (CI-18). Lo firma el Tema 03 y nosotros solo lo validamos.
# Es el UNICO acuerdo criptografico de todo nuestro contrato.
SECRETO_VALE=alfa-g04-secreto-del-vale-no-usar-en-produccion

# Credencial del despacho de entregas (CI-22): identifica a un SERVICIO,
# no a una persona.
CLAVE_DESPACHO=alfa-g04-clave-de-despacho
